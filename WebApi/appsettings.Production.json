{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  // The connection string is NOT stored here. Set the environment variable
  // ConnectionStrings__DefaultConnection on the server (see appsettings.json for an example).
  // Also set on the server: DataProtection__KeysDirectory=<persistent folder/volume, readable only by the app>
  // and, when nginx runs outside the container, ForwardedHeaders__KnownNetworks=172.16.0.0/12
  "FilePaths": {
    "LogFileRootDirectory": "/var/log/dotnet/webapi"
  }
}
