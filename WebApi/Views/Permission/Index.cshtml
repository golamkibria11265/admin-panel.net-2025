<div class="col-12">
    <div class="card">
        <div class="d-flex justify-content-center">
            <div class="card-header">
                <a id="btnSearch" href="#" class="btn btn-success text-white"><i class="fas fa-random"></i>Allow all menus as permission</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#btnSearch").click(function (e) {
            e.preventDefault();
            activatejQueryTable();
        });
        function activatejQueryTable() {
            try {
                $.ajax({
                    type: 'POST', // changes data: POST + anti-forgery header (added globally in _Layout)
                    url: '@Url.Action("SyncPermissionList", "Permission")',
                    success: function (res) {
                        if (res.hasOwnProperty('code') && res.code == 200) {
                            res.messages.forEach(element => {
                                toastr.success(element);
                            });
                        }
                        else {
                            if (res.hasOwnProperty('session_expired') && res.session_expired) {
                                window.location.href = res.redirect_url;
                            }
                            else if (res.hasOwnProperty('code') && res.code != 200) {
                                res.messages.forEach(element => {
                                    toastr.error(element);
                                });
                            }
                            else {
                                toastr.error('Failed');
                            }
                        }
                    },
                    error: function (err) {
                        errorResponse(err);
                    }
                })
                return false;
            } catch (ex) {
                console.log(ex)
            }
        }
    </script>
    <script src="~/js/CustomScripts/permission.js"></script>
}
