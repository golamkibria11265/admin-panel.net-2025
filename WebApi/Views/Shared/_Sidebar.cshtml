        <div class="collapse navbar-collapse" id="sidebar-menu">
            <ul class="navbar-nav pt-lg-3">
                @if (roleWiseScreenPermissions != null && roleWiseScreenPermissions.Count > 0)
                {
                    foreach (var level1 in roleWiseScreenPermissions)
                    {
                        var level1Active = level1.ControllerName?.ToLower() == controller.ToLower() ? "active" : "";
                        var level1Show = level1Active == "active" ? "show" : "";
                        if (level1.ChildMenuViewModels == null || level1.ChildMenuViewModels.Count == 0)
                        {
                            <li class="nav-item @level1Active">
                                <a class="nav-link" href="@Url.Action(level1.ActionName, level1.ControllerName)">
                                    <span class="nav-link-title">@level1.Name</span>
                                </a>
                            </li>
                        }
                        else
                        {
