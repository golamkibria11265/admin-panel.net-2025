                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="false">
                                    <span class="nav-link-title">@level1.Name</span>
                                </a>
                                <div class="dropdown-menu @level1Show">
                                    <div class="dropdown-menu-columns">
                                        <div class="dropdown-menu-column">
                                            @foreach (var level2 in level1.ChildMenuViewModels)
