@using Dll.Models.ViewModels
@using System.Text.Json
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var permissionString = HttpContextAccessor.HttpContext?.Session.GetString("RoleWiseMenuPermission");
    List<NestedMenuInfoViewModel>? roleWiseScreenPermissions = null;
    if (!string.IsNullOrEmpty(permissionString))
    {
        try { roleWiseScreenPermissions = JsonSerializer.Deserialize<List<NestedMenuInfoViewModel>>(permissionString); }
        catch (JsonException) { roleWiseScreenPermissions = null; }
    }
    var sidebarUserName = HttpContextAccessor.HttpContext?.Session.GetString("UserName");
    var sidebarRoleName = HttpContextAccessor.HttpContext?.Session.GetString("RoleName");
    string controller = Convert.ToString(ViewContext.RouteData.Values["Controller"]) ?? string.Empty;
    string action = Convert.ToString(ViewContext.RouteData.Values["Action"]) ?? string.Empty;
}
