@model IEnumerable<Dll.Models.ViewModels.MenuViewModel>
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var addPermission = HttpContextAccessor.HttpContext?.Session.GetString("addPermission");
    var editPermission = HttpContextAccessor.HttpContext?.Session.GetString("editPermission");
    var deletePermission = HttpContextAccessor.HttpContext?.Session.GetString("deletePermission");
}

<div class="col-12">
    <div class="card">
        <div class="d-flex justify-content-between">
            <div class="card-header">
                <h3 class="card-title">Menu List</h3>
            </div>
            <div class="card-header">
                @if (addPermission == "Y")
                {
                    <a id="addNew" onclick="showInPopup('@Url.Action("Add","Menu",new {id=0,parent = 0, parentName = "HHH"})','New Menu')" class="btn btn-success text-white"><i class="fas fa-random"></i>Add New</a>
                }
            </div>
        </div>
        <div class="card-body">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb" id="breadcrumbList">
                </ol>
            </nav>
            <div>
                <div class="table-responsive">
                    <table class="table table-striped table-condensed" id="menu_table">
                        <thead>
                            <tr>
                                <th class="w-1"><input class="form-check-input m-0 align-middle" type="checkbox" aria-label="Select all invoices"></th>
                                <th>NAME</th>
                                <th>URL</th>
                                <th>ISACTION</th>
                                <th>MENU ORDER</th>
                                <th>IMAGE</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        function initializeDataTable(id, name) 
        {
            if ($.fn.DataTable.isDataTable('#menu_table')) {
                $('#menu_table').DataTable().destroy();
            }
            $('#menu_table').DataTable({
                "searching": true,
                "processing": true,
                "serverSide": true,
                "searchDelay": 1000,
                "ajax": {
                    "url": "@Url.Action("PaginatedMenus", "Menu")",
                    "type": "POST",
                    "dataType": "json",
                    "data": function (d) {
                        d.id = id;
                    }
                },
                "columns": [
                    { "data": "id" },
                    { "data": "name" },
                    { "data": "url" },
                    { "data": "isAction" },
                    { "data": "menuOrder" },
                    {
                        "data": "imageUrl",
                        "render": function (data, type, row) {
                            return '<img src="' + data + '" alt="Logo" class="avatar avatar-sm" style="max-width: 25px; max-height: 25px;">';
                        }
                    },
                    {
                        "data": null,
                        "render": function (data, type, row) {
                            if (row.isAction == true && '@editPermission' == 'Y' && '@deletePermission' == 'N') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-primary edit-btn">Edit</button>`;
                            }
                            if (row.isAction == true && '@editPermission' == 'N' && '@deletePermission' == 'Y') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-danger delete-btn">Delete</button>`;
                            }
                            if (row.isAction == true && '@editPermission' == 'Y' && '@deletePermission' == 'Y') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-primary edit-btn">Edit</button>` +
                                    `<button data-id="${row.id}" class="btn btn-sm btn-danger delete-btn">Delete</button>`;
                            }
                            if (row.isAction == true && '@editPermission' == 'N' && '@deletePermission' == 'N') {
                                return ``;
                            }
                            if (row.isAction == false && '@editPermission' == 'Y' && '@deletePermission' == 'N') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-primary edit-btn">Edit</button>` +
                                    `<button data-id="${row.id}"data-name="${row.name}" class="btn btn-sm btn-info detail-btn">Next</button>`;
                            }
                            if (row.isAction == false && '@editPermission' == 'N' && '@deletePermission' == 'Y') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-danger delete-btn">Delete</button>` +
                                    `<button data-id="${row.id}"data-name="${row.name}" class="btn btn-sm btn-info detail-btn">Next</button>`;
                            }
                            if (row.isAction == false && '@editPermission' == 'Y' && '@deletePermission' == 'Y') {
                                return `<button data-id="${row.id}" class="btn btn-sm btn-primary edit-btn">Edit</button>` +
                                    `<button data-id="${row.id}" class="btn btn-sm btn-danger delete-btn">Delete</button>` +
                                    `<button data-id="${row.id}"data-name="${row.name}" class="btn btn-sm btn-info detail-btn">Next</button>`;
                            }
                            if (row.isAction == false && '@editPermission' == 'N' && '@deletePermission' == 'N') {
                                return `<button data-id="${row.id}"data-name="${row.name}" class="btn btn-sm btn-info detail-btn">Next</button>`;
                            }
                        }
                    }
                ],
                "pageLength": 7,
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "print", "colvis"]
            }).buttons().container().appendTo('#menu_table_wrapper .col-md-6:eq(0)');
            updateBreadcrumb(id, name);
        }
        function updateBreadcrumb(id, name) {
            $('#breadcrumbList').children().each(function () {
                if ($(this).data('id') > id) {
                    $(this).remove();
                }
            });
            var breadcrumbItem = $('#breadcrumbItem_' + id);
            if (breadcrumbItem.length > 0) {
                breadcrumbItem.addClass('active');
            } else {
                $('#breadcrumbList').append(`<li class="breadcrumb-item-custom active" id="breadcrumbItem_${id}" data-id="${id}"><b>${name}</b></li>`);
            }
            $('#breadcrumbItem_' + id).on('click', function () {
                initializeDataTable(id, name);
            });
            var url = '@Url.Action("Add", "Menu")';
            url += '?id=0&parent=' + id + '&parentName=' + name;
            var addNewLink = document.getElementById('addNew');
            addNewLink.setAttribute('onclick', "showInPopup('" + url + "','New Menu')");
        }
        $(document).ready(function () {
            initializeDataTable(null,"Parent");
        });
        $('#menu_table').on('click', '.edit-btn', function () {
            var id = $(this).data('id');
            var editUrl = `@Url.Action("Edit", "Menu")?id=${id}`;
            showInPopup(editUrl, 'Update Menu');
        });
        $('#menu_table').on('click', '.delete-btn', function () {
            var id = $(this).data('id');
            var deleteUrl = `@Url.Action("Delete", "Menu")?id=${id}`;
            jQueryAjaxDelete(deleteUrl, id);
        });
        $('#menu_table').on('click', '.detail-btn', function () {
            var id = $(this).data('id');
            var name = $(this).data('name');
            initializeDataTable(id,name);
            updateBreadcrumb(id, name);
        });
    </script>
    <script src="~/js/customscripts/menu.js"></script>
}




