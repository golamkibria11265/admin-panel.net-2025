@model IEnumerable<Dll.Models.ViewModels.MenuViewModel>
@{
    // Set by MenuController.Index from the database. Only controls which buttons are shown;
    // the server checks every Add/Edit/Delete request again.
    var addPermission = ViewData["addPermission"] as string ?? "N";
    var editPermission = ViewData["editPermission"] as string ?? "N";
    var deletePermission = ViewData["deletePermission"] as string ?? "N";
}

<div class="col-12">
    <div class="card">
        <div class="d-flex justify-content-between">
            <div class="card-header">
                <h3 class="card-title">Menu List</h3>
            </div>
            <div class="card-header">
                @if (addPermission == "Y")
                {
                    <a id="addNew" href="#" class="btn btn-success text-white"><i class="fas fa-random"></i>Add New</a>
                }
            </div>
        </div>
        <div class="card-body">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb" id="breadcrumbList">
                </ol>
            </nav>
            <div>
                <div class="table-responsive">
                    <table class="table table-striped table-condensed" id="menu_table">
                        <thead>
                            <tr>
                                <th class="w-1"><input class="form-check-input m-0 align-middle" type="checkbox" aria-label="Select all invoices"></th>
                                <th>NAME</th>
                                <th>URL</th>
                                <th>ISACTION</th>
                                <th>MENU ORDER</th>
                                <th>IMAGE</th>
                                <th>ACTION</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        const canEdit = '@editPermission' === 'Y';
        const canDelete = '@deletePermission' === 'Y';
        const addUrlBase = '@Url.Action("Add", "Menu")';
        let currentParentId = 0;
        let currentParentName = '';

        function actionButtons(row) {
            const id = parseInt(row.id, 10) || 0;
            let html = '';
            if (canEdit) {
                html += `<button data-id="${id}" class="btn btn-sm btn-primary edit-btn">Edit</button>`;
            }
            if (canDelete) {
                html += `<button data-id="${id}" class="btn btn-sm btn-danger delete-btn">Delete</button>`;
            }
            if (row.isAction == false) {
                html += `<button data-id="${id}" data-name="${escapeHtml(row.name)}" class="btn btn-sm btn-info detail-btn">Next</button>`;
            }
            return html;
        }

        function initializeDataTable(id, name)
        {
            if ($.fn.DataTable.isDataTable('#menu_table')) {
                $('#menu_table').DataTable().destroy();
            }
            const textRender = function (data) { return escapeHtml(data); };
            $('#menu_table').DataTable({
                "searching": true,
                "processing": true,
                "serverSide": true,
                "searchDelay": 1000,
                "ajax": {
                    "url": "@Url.Action("PaginatedMenus", "Menu")",
                    "type": "POST",
                    "dataType": "json",
                    "data": function (d) {
                        d.id = id;
                    },
                    "dataSrc": function (json) {
                        if (json.session_expired) {
                            window.location.href = json.redirect_url;
                            return [];
                        }
                        if (json.code && json.code !== 200 && json.messages) {
                            json.messages.forEach(m => toastr.error(m));
                            return [];
                        }
                        return json.data || [];
                    }
                },
                "columns": [
                    { "data": "id", "render": textRender },
                    { "data": "name", "render": textRender },
                    { "data": "url", "render": textRender },
                    { "data": "isAction", "render": textRender },
                    { "data": "menuOrder", "render": textRender },
                    {
                        "data": "imageUrl",
                        "render": function (data, type, row) {
                            if (!data) return '';
                            return `<img src="${escapeHtml(data)}" alt="Logo" class="avatar avatar-sm" style="max-width: 25px; max-height: 25px;">`;
                        }
                    },
                    {
                        "data": null,
                        "orderable": false,
                        "render": function (data, type, row) {
                            return actionButtons(row);
                        }
                    }
                ],
                "pageLength": 7,
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "buttons": ["copy", "csv", "excel", "print", "colvis"]
            }).buttons().container().appendTo('#menu_table_wrapper .col-md-6:eq(0)');
            updateBreadcrumb(id, name);
        }

        function updateBreadcrumb(id, name) {
            const numericId = parseInt(id, 10) || 0;
            $('#breadcrumbList').children().each(function () {
                if ($(this).data('id') > numericId) {
                    $(this).remove();
                }
            });
            const breadcrumbItem = $('#breadcrumbItem_' + numericId);
            if (breadcrumbItem.length > 0) {
                breadcrumbItem.addClass('active');
            } else {
                // Built with jQuery .text() so a menu name can never inject HTML.
                const li = $('<li class="breadcrumb-item-custom active"></li>')
                    .attr('id', 'breadcrumbItem_' + numericId)
                    .attr('data-id', numericId)
                    .append($('<b></b>').text(name || ''));
                li.on('click', function () {
                    initializeDataTable(numericId || null, name);
                });
                $('#breadcrumbList').append(li);
            }
            currentParentId = numericId;
            currentParentName = name || '';
        }

        $('#addNew').on('click', function (e) {
            e.preventDefault();
            const url = addUrlBase + '?id=0&parent=' + encodeURIComponent(currentParentId) +
                '&parentName=' + encodeURIComponent(currentParentName);
            showInPopup(url, 'New Menu');
        });
        $(document).ready(function () {
            initializeDataTable(null, "Parent");
        });
        $('#menu_table').on('click', '.edit-btn', function () {
            const id = parseInt($(this).data('id'), 10) || 0;
            const editUrl = '@Url.Action("Edit", "Menu")?id=' + id;
            showInPopup(editUrl, 'Update Menu');
        });
        $('#menu_table').on('click', '.delete-btn', function () {
            const id = parseInt($(this).data('id'), 10) || 0;
            jQueryAjaxDelete('@Url.Action("Delete", "Menu")', id);
        });
        $('#menu_table').on('click', '.detail-btn', function () {
            const id = parseInt($(this).data('id'), 10) || 0;
            const name = $(this).data('name');
            initializeDataTable(id, name);
        });
    </script>
    <script src="~/js/CustomScripts/menu.js" asp-append-version="true"></script>
}
