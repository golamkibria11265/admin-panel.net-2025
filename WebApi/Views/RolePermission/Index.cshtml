@model Dll.Models.ViewModels.RolePermissionNestedViewModel

<form asp-action="UpdateRolePermissionsByRole" method="post" onsubmit="return jQueryAjaxPost(this);">
    <div class="col-12">
        <div class="col-md-12">
            <div class="card card-primary">
                <div class="d-flex justify-content-between">
                        <div class="card-header">
                            <h3 class="card-title">Role wise permissions</h3>
                        </div>
                        <div class="card-header">
                            <div class="d-flex justify-content-end mt-2">
                                <input type="submit" value="Submit" class="btn btn-primary btn-block" />
                            </div>
                        </div>
                    </div>
                <div class="card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="form-label">Role</label>
                                    <select asp-for="RoleId" id="ddOfRole" class="form-control" onchange="fetchRolePermissionsByRoleId(this.value)"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="permissions-container">
                        </div>
                    </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            LoadRoleList();
        });

        function LoadRoleList() {
            GetDropdownWithEmptySelector('@Url.Action("GetRoleList", "Common")', "#ddOfRole", "Role");
        }

        function fetchRolePermissionsByRoleId(roleId) {
            if (!roleId) return;

            $.ajax({
                url: '@Url.Action("GetRolePermissionsByRoleId", "RolePermission")',
                type: 'POST',
                data: { roleId: roleId },
                success: function (res) {
                    if (res.hasOwnProperty('code') && res.code == 200) {
                        res.messages.forEach(element => {
                            toastr.success(element);
                        });
                        renderPermissions(res.data.rolePermissionNestedViewModelList);
                    } else {
                        if (res.hasOwnProperty('session_expired') && res.session_expired) {
                            window.location.href = res.redirect_url;
                        } else if (res.hasOwnProperty('code') && res.code != 200) {
                            res.messages.forEach(element => {
                                toastr.error(element);
                            });
                        } else {
                            toastr.error('Failed');
                        }
                    }
                },
                error: function (err) {
                    errorResponse(err);
                }
            });
        }

        function renderPermissions(permissions) {
            const container = $("#permissions-container");
            container.empty();

            permissions.forEach((permission, index) => {
                const cardHtml = createPermissionCard(permission, `RolePermissionNestedViewModelList[${index}]`);
                container.append(cardHtml);
            });
        }

        function createPermissionCard(permission, prefix) {
            let card = $('<div class="col-sm-4" style="margin-top: 20px;">' +
                '<div class="card">' +
                '<div class="form-group">' +
                `<input type="hidden" name="${prefix}.Id" value="${permission.id}">` +
                `<input type="hidden" name="${prefix}.Name" value="${permission.name}">` +
                `<input type="hidden" name="${prefix}.RoleId" value="${permission.roleId}">` +
                `<input type="hidden" name="${prefix}.PermissionId" value="${permission.permissionId}">` +
                `<input type="hidden" name="${prefix}.MenuId" value="${permission.menuId}">` +
                `<input type="hidden" name="${prefix}.ParentId" value="${permission.parentId}">` +
                `<input type="checkbox" class="form-check-input" name="${prefix}.IsSelected" id="${prefix}_IsSelected" value="true" ${permission.isSelected ? 'checked' : ''} data-id="${permission.id}">` +
                `<a>${permission.name}</a>` +
                '</div>' +
                '<ul></ul>' +
                '</div>' +
                '</div>');

            let ul = card.find('ul');
            permission.childRolePermissionViewModels.forEach((child, childIndex) => {
                ul.append(createChildPermissionCard(child, `${prefix}.ChildRolePermissionViewModels[${childIndex}]`));
            });

            return card;
        }

        function createChildPermissionCard(childPermission, prefix) {
            let li = $('<li>' +
                '<div class="form-group">' +
                `<input type="hidden" name="${prefix}.Id" value="${childPermission.id}">` +
                `<input type="hidden" name="${prefix}.Name" value="${childPermission.name}">` +
                `<input type="hidden" name="${prefix}.RoleId" value="${childPermission.roleId}">` +
                `<input type="hidden" name="${prefix}.PermissionId" value="${childPermission.permissionId}">` +
                `<input type="hidden" name="${prefix}.MenuId" value="${childPermission.menuId}">` +
                `<input type="hidden" name="${prefix}.ParentId" value="${childPermission.parentId}">` +
                `<input type="checkbox" class="form-check-input" name="${prefix}.IsSelected" id="${prefix}_IsSelected" value="true" ${childPermission.isSelected ? 'checked' : ''} data-id="${childPermission.id}">` +
                `<a>${childPermission.name}</a>` +
                '</div>' +
                '<ul></ul>' +
                '</li>');

            let ul = li.find('ul');
            childPermission.childRolePermissionViewModels.forEach((grandChild, grandChildIndex) => {
                ul.append(createChildPermissionCard(grandChild, `${prefix}.ChildRolePermissionViewModels[${grandChildIndex}]`)); // Recursively create nested permissions
            });

            return li;
        }
    </script>

    <script src="~/js/CustomScripts/rolepermission.js"></script>
    <script src="~/js/CustomScripts/CommonDropdown.js"></script>
}
