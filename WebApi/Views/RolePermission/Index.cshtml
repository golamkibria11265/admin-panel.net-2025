@model Dll.Models.ViewModels.RolePermissionNestedViewModel

<form asp-action="UpdateRolePermissionsByRole" method="post" onsubmit="return jQueryAjaxPost(this);">
    <div class="col-12">
        <div class="col-md-12">
            <div class="card card-primary">
                <div class="d-flex justify-content-between">
                        <div class="card-header">
                            <h3 class="card-title">Role wise permissions</h3>
                        </div>
                        <div class="card-header">
                            <div class="d-flex justify-content-end mt-2">
                                <input type="submit" value="Submit" class="btn btn-primary btn-block" />
                            </div>
                        </div>
                    </div>
                <div class="card-body">
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="form-label">Role</label>
                                    <select asp-for="RoleId" id="ddOfRole" class="form-control" onchange="fetchRolePermissionsByRoleId(this.value)"></select>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="permissions-container">
                        </div>
                    </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        $(document).ready(function () {
            LoadRoleList();
        });

        function LoadRoleList() {
            GetDropdownWithEmptySelector('@Url.Action("GetRoleList", "Common")', "#ddOfRole", "Role");
        }

        function fetchRolePermissionsByRoleId(roleId) {
            if (!roleId) return;

            $.ajax({
                url: '@Url.Action("GetRolePermissionsByRoleId", "RolePermission")',
                type: 'POST',
                data: { roleId: roleId },
                success: function (res) {
                    if (res.hasOwnProperty('code') && res.code == 200) {
                        res.messages.forEach(element => {
                            toastr.success(element);
                        });
                        renderPermissions(res.data.rolePermissionNestedViewModelList);
                    } else {
                        if (res.hasOwnProperty('session_expired') && res.session_expired) {
                            window.location.href = res.redirect_url;
                        } else if (res.hasOwnProperty('code') && res.code != 200) {
                            res.messages.forEach(element => {
                                toastr.error(element);
                            });
                        } else {
                            toastr.error('Failed');
                        }
                    }
                },
                error: function (err) {
                    errorResponse(err);
                }
            });
        }

        function renderPermissions(permissions) {
            const container = $("#permissions-container");
            container.empty();

            permissions.forEach((permission, index) => {
                const cardHtml = createPermissionCard(permission, `RolePermissionNestedViewModelList[${index}]`);
                container.append(cardHtml);
            });
        }

        // Builds the permission tree with jQuery attr()/text() so menu names can never inject HTML or script.
        function hiddenInput(name, value) {
            return $('<input type="hidden">').attr('name', name).val(value === null || value === undefined ? '' : value);
        }

        function permissionFields(permission, prefix) {
            const group = $('<div class="form-group"></div>');
            group.append(hiddenInput(`${prefix}.Id`, permission.id));
            group.append(hiddenInput(`${prefix}.Name`, permission.name));
            group.append(hiddenInput(`${prefix}.RoleId`, permission.roleId));
            group.append(hiddenInput(`${prefix}.PermissionId`, permission.permissionId));
            group.append(hiddenInput(`${prefix}.MenuId`, permission.menuId));
            group.append(hiddenInput(`${prefix}.ParentId`, permission.parentId));
            const checkbox = $('<input type="checkbox" class="form-check-input" value="true">')
                .attr('name', `${prefix}.IsSelected`)
                .attr('id', `${prefix}_IsSelected`)
                .attr('data-id', permission.id)
                .prop('checked', !!permission.isSelected);
            group.append(checkbox);
            group.append($('<a></a>').text(permission.name || ''));
            return group;
        }

        function appendChildren(ul, permission, prefix) {
            (permission.childRolePermissionViewModels || []).forEach((child, childIndex) => {
                ul.append(createChildPermissionCard(child, `${prefix}.ChildRolePermissionViewModels[${childIndex}]`));
            });
        }

        function createPermissionCard(permission, prefix) {
            const card = $('<div class="col-sm-4" style="margin-top: 20px;"><div class="card"></div></div>');
            const inner = card.find('.card');
            inner.append(permissionFields(permission, prefix));
            const ul = $('<ul></ul>');
            inner.append(ul);
            appendChildren(ul, permission, prefix);
            return card;
        }

        function createChildPermissionCard(childPermission, prefix) {
            const li = $('<li></li>');
            li.append(permissionFields(childPermission, prefix));
            const ul = $('<ul></ul>');
            li.append(ul);
            appendChildren(ul, childPermission, prefix); // recursive: any depth
            return li;
        }
    </script>

    <script src="~/js/CustomScripts/rolepermission.js"></script>
    <script src="~/js/CustomScripts/CommonDropdown.js"></script>
}
