{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  // SECRETS DO NOT BELONG IN THIS FILE (it is committed to Git).
  // Provide them as environment variables (or a secret store), for example in the .env of docker compose:
  //   ConnectionStrings__DefaultConnection=Server=mssql,1433;Database=DotNet;User Id=[APP_DB_USER];Password=[APP_DB_PASSWORD];Encrypt=True;TrustServerCertificate=True
  //   Redis__Server=redis:6379,password=[REDIS_PASSWORD]
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "FilePaths": {
    "LogFileRootDirectory": ""
  },
  "Redis": {
    "Enabled": false,
    "Server": "",
    "Database": "AdminPanel:"
  },
  "DataProtection": {
    // Folder for the key ring that protects session/anti-forgery cookies. Use a persistent volume in Docker.
    "KeysDirectory": ""
  },
  "ForwardedHeaders": {
    // Extra proxies/networks allowed to send X-Forwarded-* (loopback is always trusted), separated by ';'.
    "KnownNetworks": "",
    "KnownProxies": ""
  },
  "AppBaseUrl": "/images",
  "DefaultEmptyImageName": ""
}
